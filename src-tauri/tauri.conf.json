{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoudaMix",
  "version": "0.1.0",
  "identifier": "com.roudamix.app",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "RoudaMix",
        "width": 1100,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../engine/build/Release/roudamix-engine.exe": "roudamix-engine.exe",
      "../engine/build/Release/roudamix-worker.exe": "roudamix-worker.exe"
    }
  }
}
