{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roudamix.local/protocol/v1",
  "title": "RoudaMix Engine Protocol v1",
  "description": "Frame payload 層契約(framing 見 contracts/protocol.md)。本檔為唯一權威。",
  "$defs": {
    "u16": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "u32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "u64": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
    "f32": { "type": "number", "minimum": -3.4028235e38, "maximum": 3.4028235e38 },
    "normalized": { "type": "number", "minimum": 0, "maximum": 1 },

    "deviceInfo": {
      "type": "object",
      "required": ["deviceKey", "name", "maxIn", "maxOut", "sampleRates", "currentSampleRate", "minBufferSize", "maxBufferSize", "preferredBufferSize", "bufferSizes"],
      "properties": {
        "deviceKey": { "type": "string" },
        "name": { "type": "string" },
        "maxIn": { "$ref": "#/$defs/u16" },
        "maxOut": { "$ref": "#/$defs/u16" },
        "sampleRates": { "type": "array", "items": { "$ref": "#/$defs/u32" } },
        "currentSampleRate": { "$ref": "#/$defs/u32" },
        "minBufferSize": { "$ref": "#/$defs/u32" },
        "maxBufferSize": { "$ref": "#/$defs/u32" },
        "preferredBufferSize": { "$ref": "#/$defs/u32" },
        "bufferSizes": { "type": "array", "items": { "$ref": "#/$defs/u32" } }
      }
    },

    "engineStatus": {
      "type": "object",
      "required": ["running", "deviceKey", "sampleRate", "bufferSize", "inputLatency", "outputLatency", "xruns", "source", "sineFreq", "inputMono", "error"],
      "properties": {
        "running": { "type": "boolean" },
        "deviceKey": { "type": ["string", "null"] },
        "sampleRate": { "$ref": "#/$defs/f32" },
        "bufferSize": { "type": ["integer", "null"] },
        "inputLatency": { "type": ["integer", "null"] },
        "outputLatency": { "type": ["integer", "null"] },
        "xruns": { "$ref": "#/$defs/u64" },
        "source": { "enum": ["sine", "passthrough"] },
        "sineFreq": { "$ref": "#/$defs/f32" },
        "inputMono": { "type": "boolean" },
        "error": { "type": ["string", "null"] }
      }
    },

    "paramInfo": {
      "type": "object",
      "required": ["paramId", "name", "normalized", "formatted", "bypass"],
      "properties": {
        "paramId": { "$ref": "#/$defs/u32" },
        "name": { "type": "string" },
        "normalized": { "$ref": "#/$defs/normalized" },
        "formatted": { "type": "string" },
        "bypass": { "type": "boolean" }
      }
    },

    "rackSlot": {
      "type": "object",
      "required": ["instanceId", "name", "pluginPath", "bypassed"],
      "properties": {
        "instanceId": { "$ref": "#/$defs/u32" },
        "name": { "type": "string" },
        "pluginPath": { "type": "string" },
        "bypassed": { "type": "boolean" }
      }
    },

    "pluginInfo": {
      "type": "object",
      "required": ["path", "name", "vendor", "category", "uid"],
      "properties": {
        "path": { "type": "string" },
        "name": { "type": "string" },
        "vendor": { "type": "string" },
        "category": { "type": "string" },
        "uid": { "type": "string" }
      }
    },

    "snapshot": {
      "type": "object",
      "required": ["epoch", "engineVersion", "status", "rack", "lastScan"],
      "properties": {
        "epoch": { "$ref": "#/$defs/u64" },
        "engineVersion": { "type": "string" },
        "status": { "$ref": "#/$defs/engineStatus" },
        "rack": { "type": "array", "items": { "$ref": "#/$defs/rackSlot" } },
        "lastScan": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "$ref": "#/$defs/pluginInfo" } }
          ]
        }
      }
    },

    "errorCode": {
      "enum": [
        "unsupported_version", "bad_frame", "bad_command", "not_running",
        "already_running", "device_open_failed", "device_lost",
        "plugin_not_found", "plugin_load_failed", "plugin_no_editor",
        "param_not_found", "session_io", "preset_io", "plugin_state_failed",
        "internal"
      ]
    },

    "command": {
      "oneOf": [
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "ping" },
            "payload": { "type": "object" }
          }
        },
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "get_snapshot" },
            "payload": { "type": "object" }
          }
        },
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "list_devices" },
            "payload": { "type": "object" }
          }
        },
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "start" },
            "payload": {
              "type": "object",
              "required": ["deviceKey", "sampleRate"],
              "properties": {
                "deviceKey": { "type": "string" },
                "sampleRate": { "oneOf": [ { "$ref": "#/$defs/u32" }, { "type": "null" } ] },
                "bufferSize": { "oneOf": [ { "$ref": "#/$defs/u32" }, { "type": "null" } ] },
                "inputMono": { "type": "boolean" }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "stop" },
            "payload": { "type": "object" }
          }
        },
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "open_device_panel" },
            "payload": { "type": "object" }
          }
        },
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "set_source" },
            "payload": {
              "type": "object",
              "required": ["source", "sineFreq"],
              "properties": {
                "source": { "enum": ["sine", "passthrough"] },
                "sineFreq": { "$ref": "#/$defs/f32" }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "scan_plugins" },
            "payload": {
              "type": "object",
              "properties": { "roots": { "type": "array", "items": { "type": "string" } } }
            }
          }
        },
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "add_plugin" },
            "payload": {
              "type": "object",
              "required": ["path"],
              "properties": { "path": { "type": "string" } }
            }
          }
        },
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "remove_plugin" },
            "payload": {
              "type": "object",
              "required": ["instanceId"],
              "properties": { "instanceId": { "$ref": "#/$defs/u32" } }
            }
          }
        },
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "move_plugin" },
            "payload": {
              "type": "object",
              "required": ["instanceId", "newIndex"],
              "properties": {
                "instanceId": { "$ref": "#/$defs/u32" },
                "newIndex": { "$ref": "#/$defs/u32" }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "set_bypass" },
            "payload": {
              "type": "object",
              "required": ["instanceId", "bypassed"],
              "properties": {
                "instanceId": { "$ref": "#/$defs/u32" },
                "bypassed": { "type": "boolean" }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "set_param" },
            "payload": {
              "type": "object",
              "required": ["instanceId", "paramId", "value"],
              "properties": {
                "instanceId": { "$ref": "#/$defs/u32" },
                "paramId": { "$ref": "#/$defs/u32" },
                "value": { "$ref": "#/$defs/normalized" }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "get_params" },
            "payload": {
              "type": "object",
              "required": ["instanceId"],
              "properties": { "instanceId": { "$ref": "#/$defs/u32" } }
            }
          }
        },
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "open_editor" },
            "payload": {
              "type": "object",
              "required": ["instanceId"],
              "properties": { "instanceId": { "$ref": "#/$defs/u32" } }
            }
          }
        },
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "close_editor" },
            "payload": {
              "type": "object",
              "required": ["instanceId"],
              "properties": { "instanceId": { "$ref": "#/$defs/u32" } }
            }
          }
        },
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "save_preset" },
            "payload": {
              "type": "object",
              "required": ["instanceId", "path"],
              "properties": {
                "instanceId": { "$ref": "#/$defs/u32" },
                "path": { "type": "string" }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "load_preset" },
            "payload": {
              "type": "object",
              "required": ["instanceId", "path"],
              "properties": {
                "instanceId": { "$ref": "#/$defs/u32" },
                "path": { "type": "string" }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "save_session" },
            "payload": {
              "type": "object",
              "properties": {
                "path": { "oneOf": [ { "type": "string" }, { "type": "null" } ] },
                "deviceKey": { "oneOf": [ { "type": "string" }, { "type": "null" } ] },
                "sampleRate": { "oneOf": [ { "$ref": "#/$defs/u32" }, { "type": "null" } ] },
                "bufferSize": { "oneOf": [ { "$ref": "#/$defs/u32" }, { "type": "null" } ] },
                "inputMono": { "type": "boolean" }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "load_session" },
            "payload": {
              "type": "object",
              "required": ["path"],
              "properties": { "path": { "type": "string" } }
            }
          }
        },
        {
          "type": "object",
          "required": ["protocolVersion", "id", "kind", "payload"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "$ref": "#/$defs/u64" },
            "kind": { "const": "shutdown_engine" },
            "payload": { "type": "object" }
          }
        }
      ]
    },

    "replyOk": {
      "type": "object",
      "required": ["id", "ok", "epoch", "result"],
      "properties": {
        "id": { "$ref": "#/$defs/u64" },
        "ok": { "const": true },
        "epoch": { "$ref": "#/$defs/u64" },
        "result": { "type": "object" }
      }
    },

    "replyErr": {
      "type": "object",
      "required": ["id", "ok", "epoch", "error"],
      "properties": {
        "id": { "$ref": "#/$defs/u64" },
        "ok": { "const": false },
        "epoch": { "$ref": "#/$defs/u64" },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "$ref": "#/$defs/errorCode" },
            "message": { "type": "string" }
          }
        }
      }
    },

    "event": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "payload"],
          "properties": {
            "kind": { "const": "snapshot" },
            "payload": { "$ref": "#/$defs/snapshot" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "payload"],
          "properties": {
            "kind": { "const": "status" },
            "payload": { "$ref": "#/$defs/engineStatus" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "payload"],
          "properties": {
            "kind": { "const": "scan_done" },
            "payload": {
              "type": "object",
              "required": ["scanId", "plugins", "failed"],
              "properties": {
                "scanId": { "$ref": "#/$defs/u32" },
                "plugins": { "type": "array", "items": { "$ref": "#/$defs/pluginInfo" } },
                "failed": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "payload"],
          "properties": {
            "kind": { "const": "rack_changed" },
            "payload": {
              "type": "object",
              "required": ["rack"],
              "properties": { "rack": { "type": "array", "items": { "$ref": "#/$defs/rackSlot" } } }
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "payload"],
          "properties": {
            "kind": { "const": "plugin_event" },
            "payload": {
              "type": "object",
              "required": ["instanceId", "what"],
              "properties": {
                "instanceId": { "$ref": "#/$defs/u32" },
                "what": { "enum": ["crashed", "recovered"] }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "payload"],
          "properties": {
            "kind": { "const": "devices_changed" },
            "payload": {
              "type": "object",
              "required": [],
              "properties": {}
            }
          }
        }
      ]
    },

    "frame": {
      "description": "任一方向的 frame payload:command、reply、event 三擇一。",
      "oneOf": [
        { "$ref": "#/$defs/command" },
        { "$ref": "#/$defs/replyOk" },
        { "$ref": "#/$defs/replyErr" },
        { "$ref": "#/$defs/event" }
      ]
    }
  }
}
