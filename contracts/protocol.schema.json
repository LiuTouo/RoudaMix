{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roudamix.local/protocol/v2",
  "title": "RoudaMix Engine Protocol v2",
  "description": "Generated control-plane sections come from command_contract.json; snapshot/status definitions remain maintained here.",
  "$defs": {
    "u16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "u64": {
      "type": "integer",
      "minimum": 0
    },
    "f32": {
      "type": "number",
      "minimum": -3.4028235e+38,
      "maximum": 3.4028235e+38
    },
    "normalized": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "deviceInfo": {
      "type": "object",
      "required": [
        "deviceKey",
        "name",
        "maxIn",
        "maxOut",
        "sampleRates",
        "currentSampleRate",
        "minBufferSize",
        "maxBufferSize",
        "preferredBufferSize",
        "bufferSizes",
        "inputNames",
        "outputNames"
      ],
      "properties": {
        "deviceKey": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "maxIn": {
          "$ref": "#/$defs/u16"
        },
        "maxOut": {
          "$ref": "#/$defs/u16"
        },
        "sampleRates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/u32"
          }
        },
        "currentSampleRate": {
          "$ref": "#/$defs/u32"
        },
        "minBufferSize": {
          "$ref": "#/$defs/u32"
        },
        "maxBufferSize": {
          "$ref": "#/$defs/u32"
        },
        "preferredBufferSize": {
          "$ref": "#/$defs/u32"
        },
        "bufferSizes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/u32"
          }
        },
        "inputNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "trackSource": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "type",
            "freq"
          ],
          "properties": {
            "type": {
              "const": "sine"
            },
            "freq": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "channel"
          ],
          "properties": {
            "type": {
              "const": "asioIn"
            },
            "channel": {
              "$ref": "#/$defs/u32"
            },
            "mono": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "pid"
          ],
          "properties": {
            "type": {
              "const": "app"
            },
            "pid": {
              "$ref": "#/$defs/u32"
            },
            "name": {
              "type": "string"
            }
          }
        }
      ]
    },
    "trackOutput": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "type",
            "channel"
          ],
          "properties": {
            "type": {
              "const": "asioOut"
            },
            "channel": {
              "$ref": "#/$defs/u32"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "deviceId"
          ],
          "properties": {
            "type": {
              "const": "wasapi"
            },
            "deviceId": {
              "type": "string"
            }
          }
        }
      ]
    },
    "track": {
      "type": "object",
      "required": [
        "trackId",
        "kind",
        "name",
        "color",
        "source",
        "dests",
        "output",
        "gain",
        "mute",
        "plugins"
      ],
      "properties": {
        "trackId": {
          "$ref": "#/$defs/u32"
        },
        "kind": {
          "enum": [
            "audio",
            "app",
            "fx",
            "output"
          ]
        },
        "systemRole": {
          "enum": [
            "monitor",
            "stream",
            null
          ]
        },
        "latencyPolicy": {
          "enum": [
            "fullPdc",
            "lowLatency"
          ]
        },
        "name": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/u32"
        },
        "source": {
          "$ref": "#/$defs/trackSource"
        },
        "dests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/u32"
          }
        },
        "output": {
          "$ref": "#/$defs/trackOutput"
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "mute": {
          "type": "boolean"
        },
        "plugins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rackSlot"
          }
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "engineStatus": {
      "type": "object",
      "required": [
        "running",
        "deviceKey",
        "sampleRate",
        "bufferSize",
        "inputLatency",
        "outputLatency",
        "xruns",
        "trackCount",
        "pluginFails",
        "tracks",
        "error"
      ],
      "properties": {
        "running": {
          "type": "boolean"
        },
        "deviceKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "sampleRate": {
          "$ref": "#/$defs/f32"
        },
        "bufferSize": {
          "type": [
            "integer",
            "null"
          ]
        },
        "inputLatency": {
          "type": [
            "integer",
            "null"
          ]
        },
        "outputLatency": {
          "type": [
            "integer",
            "null"
          ]
        },
        "xruns": {
          "$ref": "#/$defs/u64"
        },
        "trackCount": {
          "$ref": "#/$defs/u32"
        },
        "pluginFails": {
          "$ref": "#/$defs/u32"
        },
        "revision": {
          "$ref": "#/$defs/u64"
        },
        "latencyGeneration": {
          "$ref": "#/$defs/u64"
        },
        "pluginDelay": {
          "type": "object",
          "required": [
            "monitorSamples",
            "streamSamples"
          ],
          "properties": {
            "monitorSamples": {
              "type": [
                "integer",
                "null"
              ]
            },
            "streamSamples": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          }
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "paramInfo": {
      "type": "object",
      "required": [
        "paramId",
        "name",
        "normalized",
        "default",
        "bypass"
      ],
      "properties": {
        "paramId": {
          "$ref": "#/$defs/u32"
        },
        "name": {
          "type": "string"
        },
        "normalized": {
          "$ref": "#/$defs/normalized"
        },
        "default": {
          "$ref": "#/$defs/normalized"
        },
        "bypass": {
          "type": "boolean"
        }
      }
    },
    "rackSlot": {
      "type": "object",
      "required": [
        "instanceId",
        "name",
        "pluginPath",
        "bypassed"
      ],
      "properties": {
        "instanceId": {
          "$ref": "#/$defs/u32"
        },
        "name": {
          "type": "string"
        },
        "pluginPath": {
          "type": "string"
        },
        "bypassed": {
          "type": "boolean"
        },
        "monitorBypassed": {
          "type": "boolean"
        },
        "latencySamples": {
          "type": [
            "integer",
            "null"
          ]
        },
        "effectiveLatencySamples": {
          "type": [
            "integer",
            "null"
          ]
        },
        "monitorLatencySamples": {
          "type": [
            "integer",
            "null"
          ]
        },
        "runtimeState": {
          "enum": [
            "active",
            "preparing",
            "degraded",
            "suspended"
          ]
        },
        "monitorState": {
          "enum": [
            "active",
            "preparing",
            "degraded",
            "suspended"
          ]
        },
        "availability": {
          "enum": [
            "ok",
            "missing",
            "loadFailed"
          ]
        },
        "loadError": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "pluginInfo": {
      "type": "object",
      "required": [
        "path",
        "name",
        "vendor",
        "category",
        "uid"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "uid": {
          "type": "string"
        }
      }
    },
    "pluginClass": {
      "type": "object",
      "required": [
        "uid",
        "name",
        "vendor",
        "version",
        "subcategories"
      ],
      "properties": {
        "uid": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "subcategories": {
          "type": "string"
        }
      }
    },
    "scanModule": {
      "type": "object",
      "required": [
        "path",
        "classes"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pluginClass"
          }
        }
      }
    },
    "scanFailure": {
      "type": "object",
      "required": [
        "path",
        "error"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "required": [
        "epoch",
        "engineVersion",
        "status",
        "tracks",
        "lastScan"
      ],
      "properties": {
        "epoch": {
          "$ref": "#/$defs/u64"
        },
        "engineVersion": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/engineStatus"
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          }
        },
        "lastScan": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/scanModule"
              }
            }
          ]
        }
      }
    },
    "errorCode": {
      "enum": [
        "unsupported_version",
        "bad_frame",
        "bad_command",
        "not_running",
        "already_running",
        "device_open_failed",
        "device_lost",
        "track_not_found",
        "cycle_detected",
        "device_busy",
        "app_not_found",
        "unsupported_windows",
        "plugin_not_found",
        "plugin_load_failed",
        "plugin_no_editor",
        "param_not_found",
        "session_io",
        "preset_io",
        "plugin_state_failed",
        "internal"
      ]
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "protocolVersion",
            "id",
            "kind",
            "payload"
          ],
          "properties": {
            "protocolVersion": {
              "const": 2
            },
            "id": {
              "$ref": "#/$defs/u64"
            },
            "kind": {
              "const": "ping"
            },
            "payload": {
              "$ref": "#/$defs/emptyObject"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "protocolVersion",
            "id",
            "kind",
            "payload"
          ],
          "properties": {
            "protocolVersion": {
              "const": 2
            },
            "id": {
              "$ref": "#/$defs/u64"
            },
            "kind": {
              "const": "get_snapshot"
            },
            "payload": {
              "$ref": "#/$defs/emptyObject"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "protocolVersion",
            "id",
            "kind",
            "payload"
          ],
          "properties": {
            "protocolVersion": {
              "const": 2
            },
            "id": {
              "$ref": "#/$defs/u64"
            },
            "kind": {
              "const": "get_latency_report"
            },
            "payload": {
              "$ref": "#/$defs/emptyObject"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "protocolVersion",
            "id",
            "kind",
            "payload"
          ],
          "properties": {
            "protocolVersion": {
              "const": 2
            },
            "id": {
              "$ref": "#/$defs/u64"
            },
            "kind": {
              "const": "list_devices"
            },
            "payload": {
              "$ref": "#/$defs/emptyObject"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "protocolVersion",
            "id",
            "kind",
            "payload"
          ],
          "properties": {
            "protocolVersion": {
              "const": 2
            },
            "id": {
              "$ref": "#/$defs/u64"
            },
            "kind": {
              "const": "list_audio_apps"
            },
            "payload": {
              "$ref": "#/$defs/emptyObject"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "protocolVersion",
            "id",
            "kind",
            "payload"
          ],
          "properties": {
            "protocolVersion": {
              "const": 2
            },
            "id": {
              "$ref": "#/$defs/u64"
            },
            "kind": {
              "const": "list_render_devices"
            },
            "payload": {
              "$ref": "#/$defs/emptyObject"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "protocolVersion",
            "id",
            "kind",
            "payload"
          ],
          "properties": {
            "protocolVersion": {
              "const": 2
            },
            "id": {
              "$ref": "#/$defs/u64"
            },
            "kind": {
              "const": "start"
            },
            "payload": {
              "type": "object",
              "required": [
                "deviceKey",
                "sampleRate"
              ],
              "properties": {
                "deviceKey": {
                  "type": "string"
                },
                "sampleRate": {
                  "$ref": "#/$defs/nullableU32"
                },
                "bufferSize": {
                  "$ref": "#/$defs/nullableU32"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "protocolVersion",
            "id",
            "kind",
            "payload"
          ],
          "properties": {
            "protocolVersion": {
              "const": 2
            },
            "id": {
              "$ref": "#/$defs/u64"
            },
            "kind": {
              "const": "stop"
            },
            "payload": {
              "$ref": "#/$defs/emptyObject"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "protocolVersion",
            "id",
            "kind",
            "payload"
          ],
          "properties": {
            "protocolVersion": {
              "const": 2
            },
            "id": {
              "$ref": "#/$defs/u64"
            },
            "kind": {
              "const": "open_device_panel"
            },
            "payload": {
              "$ref": "#/$defs/emptyObject"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "protocolVersion",
            "id",
            "kind",
            "payload"
          ],
          "properties": {
            "protocolVersion": {
              "const": 2
            },
            "id": {
              "$ref": "#/$defs/u64"
            },
            "kind": {
              "const": "track_add"
            },
            "payload": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "audio",
                    "app",
                    "fx",
                    "output"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "color": {
                  "$ref": "#/$defs/u32"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "protocolVersion",
            "id",
            "kind",
            "payload"
          ],
          "properties": {
            "protocolVersion": {
              "const": 2
            },
            "id": {
              "$ref": "#/$defs/u64"
            },
            "kind": {
              "const": "track_remove"
            },
            "payload": {
              "type": "object",
              "required": [
                "trackId"
              ],
              "properties": {
                "trackId": {
                  "$ref": "#/$defs/u32"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "protocolVersion",
            "id",
            "kind",
            "payload"
          ],
          "properties": {
            "protocolVersion": {
              "const": 2
            },
            "id": {
              "$ref": "#/$defs/u64"
            },
            "kind": {
              "const": "track_set"
            },
            "payload": {
              "type": "object",
              "required": [
                "trackId"
              ],
              "properties": {
                "trackId": {
                  "$ref": "#/$defs/u32"
                },
                "name": {
                  "type": "string"
                },
                "color": {
                  "$ref": "#/$defs/u32"
                },
                "gain": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 4
                },
                "mute": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "protocolVersion",
            "id",
            "kind",
            "payload"
          ],
          "properties": {
            "protocolVersion": {
              "const": 2
            },
            "id": {
              "$ref": "#/$defs/u64"
            },
            "kind": {
              "const": "track_set_source"
            },
            "payload": {
              "type": "object",
              "required": [
                "trackId",
                "source"
              ],
              "properties": {
                "trackId": {
                  "$ref": "#/$defs/u32"
                },
                "source": {
                  "$ref": "#/$defs/trackSource"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "protocolVersion",
            "id",
            "kind",
            "payload"
          ],
          "properties": {
            "protocolVersion": {
              "const": 2
            },
            "id": {
              "$ref": "#/$defs/u64"
            },
            "kind": {
              "const": "track_set_dests"
            },
            "payload": {
              "type": "object",
              "required": [
                "trackId",
                "dests"
              ],
              "properties": {
                "trackId": {
                  "$ref": "#/$defs/u32"
                },
                "dests": {
                  "$ref": "#/$defs/u32Array"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "protocolVersion",
            "id",
            "kind",
            "payload"
          ],
          "properties": {
            "protocolVersion": {
              "const": 2
            },
            "id": {
              "$ref": "#/$defs/u64"
            },
            "kind": {
              "const": "track_set_output"
            },
            "payload": {
              "type": "object",
              "required": [
                "trackId",
                "output"
              ],
              "properties": {
                "trackId": {
                  "$ref": "#/$defs/u32"
                },
                "output": {
                  "$ref": "#/$defs/trackOutput"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "protocolVersion",
            "id",
            "kind",
            "payload"
          ],
          "properties": {
            "protocolVersion": {
              "const": 2
            },
            "id": {
              "$ref": "#/$defs/u64"
            },
            "kind": {
              "const": "track_set_latency_policy"
            },
            "payload": {
              "type": "object",
              "required": [
                "trackId",
                "policy"
              ],
              "properties": {
                "trackId": {
                  "$ref": "#/$defs/u32"
                },
                "policy": {
                  "enum": [
                    "fullPdc",
                    "lowLatency"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "protocolVersion",
            "id",
            "kind",
            "payload"
          ],
          "properties": {
            "protocolVersion": {
              "const": 2
            },
            "id": {
              "$ref": "#/$defs/u64"
            },
            "kind": {
              "const": "track_move"
            },
            "payload": {
              "type": "object",
              "required": [
                "trackId",
                "newIndex"
              ],
              "properties": {
                "trackId": {
                  "$ref": "#/$defs/u32"
                },
                "newIndex": {
                  "$ref": "#/$defs/u32"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "protocolVersion",
            "id",
            "kind",
            "payload"
          ],
          "properties": {
            "protocolVersion": {
              "const": 2
            },
            "id": {
              "$ref": "#/$defs/u64"
            },
            "kind": {
              "const": "start_scan"
            },
            "payload": {
              "type": "object",
              "properties": {
                "roots": {
                  "$ref": "#/$defs/stringArray"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "protocolVersion",
            "id",
            "kind",
            "payload"
          ],
          "properties": {
            "protocolVersion": {
              "const": 2
