{
  "name": "roudamix-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prototype": "vite --config vite.prototype.config.ts --mode prototype",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run test:node && npm run test:modules",
    "test:node": "node --test \"src/lib/*.test.ts\"",
    "test:modules": "vitest run src/lib/vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/api": "^2",
    "jsdom": "^30.0.1",
    "svelte": "^5",
    "svelte-check": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.3"
  }
}
